+# [K100/INT8] Keep the 51.2 GB PLE table as int8 in device memory instead of
+# dequantising it to bf16 at load time.  As bf16 it costs ~25.6 GB per TP rank
+# (~41% of the per-card weight budget) and it is used by exactly ONE layer, so
+# the whole table is resident HBM doing nothing.  Keeping int8 halves it; the
+# gather dequantises only the few KB of rows a token actually reads.
+# Set K100_PLE_INT8=0 to restore the previous bf16 behaviour.
+_PLE_INT8 = os.environ.get("K100_PLE_INT8", "1") != "0"
+
+
+def _k100_drop_bf16_table(embedding: VocabParallelEmbedding) -> None:
+    """Replace the bf16 table with an empty placeholder (frees ~23.8 GiB/rank)."""
+    w = embedding.weight
+    if w.shape[0] == 0:
+        return
+    dim = w.shape[1]
+    embedding.weight = nn.Parameter(
+        torch.empty(0, dim, dtype=w.dtype, device=w.device), requires_grad=False
+    )
+    del w
+    torch.cuda.empty_cache()
+
+
+def _k100_ensure_int8_store(embedding: VocabParallelEmbedding) -> None:
+    """Allocate the int8 weight + per-row scale store, dropping the bf16 table.
+
+    Has to happen BEFORE any shard is copied in: the bf16 table is ~23.8 GiB
+    per rank and the int8 table another ~11.9 GiB, and keeping both resident
+    at once blows the card budget during loading.
+    """
+    if hasattr(embedding, "k100_q"):
+        return
+    rows = embedding.num_embeddings_per_partition
+    dim = embedding.embedding_dim
+    w = embedding.weight
+    device, out_dtype = w.device, w.dtype
+    try:
+        before = torch.cuda.memory_allocated() / 1024**3
+    except Exception:
+        before = -1.0
+    print(
+        f"[K100-PLE-INT8] table rows={rows:,} dim={dim} "
+        f"bf16_table={(rows * dim * 2) / 1024**3:.2f}GiB "
+        f"int8_table={(rows * dim) / 1024**3:.2f}GiB "
+        f"cuda_alloc_before={before:.2f}GiB",
+        flush=True,
+    )
+    # (The bf16 table was already dropped in __init__; this is a no-op safety
+    # net in case a caller built the module another way.)
+    _k100_drop_bf16_table(embedding)
+    embedding.k100_q = torch.zeros(rows, dim, dtype=torch.int8, device=device)
+    embedding.k100_scale = torch.ones(rows, dtype=torch.float32, device=device)
+    embedding.k100_out_dtype = out_dtype
+    try:
+        after = torch.cuda.memory_allocated() / 1024**3
+        reserved = torch.cuda.memory_reserved() / 1024**3
+        print(
+            f"[K100-PLE-INT8] after free+alloc: cuda_alloc={after:.2f}GiB "
+            f"reserved={reserved:.2f}GiB (net {(after - before):+.2f}GiB)",
+            flush=True,
+        )
+    except Exception:
+        pass
+
+
+def _k100_store_int8_shard(
+    embedding: VocabParallelEmbedding,
+    shard_weight: torch.Tensor,
+    shard_scale: torch.Tensor,
+    *,
+    checkpoint_start: int,
+) -> int:
+    """Copy one checkpoint int8 shard (and its per-row scale) into the TP slice."""
+    _k100_ensure_int8_store(embedding)
+    si = embedding.shard_indices
+    overlap = compute_ple_shard_overlap(
+        checkpoint_start=checkpoint_start,
+        checkpoint_rows=shard_weight.shape[0],
+        tp_start=si.org_vocab_start_index,
+        tp_end=si.org_vocab_end_index,
+    )
+    if overlap is None:
+        return 0
+    src = shard_weight.narrow(0, overlap.source_start, overlap.row_count)
+    dst = embedding.k100_q.narrow(0, overlap.destination_start, overlap.row_count)
+    ssrc = shard_scale.reshape(-1).narrow(0, overlap.source_start, overlap.row_count)
+    sdst = embedding.k100_scale.narrow(
+        0, overlap.destination_start, overlap.row_count
+    )
+    with torch.no_grad():
+        dst.copy_(src.to(device=dst.device, dtype=torch.int8))
+        sdst.copy_(ssrc.to(device=sdst.device, dtype=torch.float32))
+    return overlap.row_count
+
+
+def _k100_int8_ngram_embedding(
+    embedding: VocabParallelEmbedding,
+    ngram_ids: torch.Tensor,
+) -> torch.Tensor:
+    """Gather + dequantise from the int8 table, mirroring VocabParallelEmbedding.
+
+    The reference implementation does the dequantisation once at load time and
+    then gathers bf16 rows.  Doing it here instead is numerically identical
+    (int8 -> fp32 multiply -> bf16, the same order the loader used) but keeps
+    the resident table half the size.
+    """
+    si = embedding.shard_indices
+    if embedding.tp_size > 1:
+        masked_input, input_mask = get_masked_input_and_mask(
+            ngram_ids,
+            si.org_vocab_start_index,
+            si.org_vocab_end_index,
+            si.num_org_vocab_padding,
+            si.added_vocab_start_index,
+            si.added_vocab_end_index,
+        )
+    else:
+        masked_input, input_mask = ngram_ids, None
+    mi = masked_input.long()
+    gathered = embedding.k100_q[mi].to(torch.float32)
+    scales = embedding.k100_scale[mi].unsqueeze(-1)
+    out = (gathered * scales).to(embedding.k100_out_dtype)
+    if input_mask is not None:
+        out.masked_fill_(input_mask.unsqueeze(-1), 0)
+        out = tensor_model_parallel_all_reduce(out)
+    return out
+
 
