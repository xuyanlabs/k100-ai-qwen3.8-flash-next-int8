+def _moe_dbg(tag: str) -> None:
+    # 仅 eager 调试用(compiled 下会被 dynamo 抹除,别在编译路径指望它)
+    if _MOEDBG and not torch.compiler.is_compiling():
+        torch.cuda.synchronize()
+        print(f"MOEDBG {tag}", flush=True)
+
+
+def _moe_stage(tag: str, t=None) -> None:
