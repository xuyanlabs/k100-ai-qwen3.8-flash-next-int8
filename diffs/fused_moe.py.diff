+    if _MOESTAGE and not torch.compiler.is_compiling():
+        torch.cuda.synchronize()
+        extra = ""
+        if t is not None:
+            with torch.no_grad():
+                tf = t.float()
+                extra = (f" nan={bool(tf.isnan().any())} "
+                         f"absmax={tf.abs().max().item() if tf.numel() else -1:.4f} "
+                         f"nz={int((tf != 0).sum())}/{tf.numel()}")
+        print(f"MOESTAGE {tag}{extra}", flush=True)
