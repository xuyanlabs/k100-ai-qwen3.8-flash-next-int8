+import os as _os
+import sys as _sys
+
+_GDNDBG = _os.getenv("GDN_DECODE_DEBUG", "0") == "1"
+
+
+def _dbg_wrap(name, fn):
+    def _w(*args, **kwargs):
+        if _GDNDBG:
+            print(f"[GDNDBG] >>> {name}", file=_sys.stderr, flush=True)
+            torch.cuda.synchronize()
+        r = fn(*args, **kwargs)
+        if _GDNDBG:
+            torch.cuda.synchronize()
+            print(f"[GDNDBG] <<< {name}", file=_sys.stderr, flush=True)
+        return r
+    return _w
+
+
